+    // ── Supersample ──────────────────────────────────────────────────────────
+
+    // The focused window at supersampleScale times its pixels: utsushot floats
+    // it and raises the output scale while it re-renders, so the desktop zooms
+    // for a moment. The PNG then goes the way of an export: copy, save, notify.
+    function supersample() {
+        if (root.active || root.capturing || root.supersampling)
+            return false
+        root.supersampling = true
+        const png = root.runtimeDir + "/supersample-" + Date.now() + ".png"
+        Proc.runCommand("screenshotPlus.supersample",
+                        ["utsushot", "-w", "--scale", String(root.supersampleScale), "-o", png],
+                        (stdout, code) => {
+            root.supersampling = false
+            if (code !== 0) {
+                console.warn("screenshotPlus: utsushot failed:", code, String(stdout).trim().slice(0, 200))
+                if (root.notify)
+                    Quickshell.execDetached(["dms", "notify", "Screenshot+", I18n.trFor("screenshotPlus", "Supersampling failed"),
+                                             "--app", "Screenshot+", "--icon", "screenshot_region"])
+                return
+            }
+            root._finalize(png, root.copyToClipboard, root.saveToFile, 0)
+        }, 0, 30000)
+        return true
+    }
+
