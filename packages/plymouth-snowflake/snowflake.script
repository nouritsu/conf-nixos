Window.SetBackgroundTopColor(@base@);
Window.SetBackgroundBottomColor(@base@);

flake.source = Image("snowflake.png");
flake.sprite = Sprite();
flake.height = 0;

frame = 0;

# called 50 times a second
fun refresh_callback ()
  {
    # rescale when the screen changes, e.g. simpledrm to nvidia
    if (Window.GetHeight() != flake.height)
      {
        flake.height = Window.GetHeight();
        flake.size = Math.Int(flake.height * 0.178);
        flake.sprite.SetImage(flake.source.Scale(flake.size, flake.size));
      }

    flake.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - flake.size / 2);
    flake.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - flake.size / 2);

    # 55-100% opacity, one breath every 1.8 s
    frame++;
    flake.sprite.SetOpacity(0.775 + 0.225 * Math.Cos(2 * Math.Pi * frame / 90));
  }

Plymouth.SetRefreshFunction(refresh_callback);

# Disk unlock, under the flake: a key until typing starts, then dots; no text.
# The key turns mauve once a security key opens the disk.

key.idle = Image("key.png");
key.done = Image("key-done.png");
key.sprite = Sprite();
key.unlocked = 0;
bullets.sprite = Sprite();

fun centre_x (image)
  {
    return Window.GetX() + Window.GetWidth() / 2 - image.GetWidth() / 2;
  }

# middle of the row the key and the dots share
fun row_y ()
  {
    return Window.GetY() + Window.GetHeight() / 2 + flake.size * 0.8;
  }

fun show_key (source, opacity)
  {
    size = Math.Int(flake.size * 0.28);
    key.image = source.Scale(size, size);
    key.sprite.SetImage(key.image);
    key.sprite.SetPosition(centre_x(key.image), row_y() - size / 2, 1);
    key.sprite.SetOpacity(opacity);
  }

fun display_password_callback (text, count)
  {
    if (key.unlocked)
      return;

    # an empty Image.Text has no size
    if (count > 0)
      {
        key.sprite.SetOpacity(0);
        dots = "";
        for (i = 0; i < count; i++)
          dots = dots + "●";
        bullets.image = Image.Text(dots, @mauve@, 1, "Sans " + Math.Int(Window.GetHeight() / 60));
        bullets.sprite.SetImage(bullets.image);
        bullets.sprite.SetPosition(centre_x(bullets.image), row_y() - bullets.image.GetHeight() / 2, 1);
        bullets.sprite.SetOpacity(1);
      }
    else
      {
        bullets.sprite.SetOpacity(0);
        show_key(key.idle, 0.7);
      }
  }

fun display_normal_callback ()
  {
    bullets.sprite.SetOpacity(0);
    if (!key.unlocked)
      key.sprite.SetOpacity(0);
  }

# the unlock step's signal; other messages, like systemd's touch prompt, stay hidden
fun display_message_callback (text)
  {
    if (text == "snowflake:unlocked")
      {
        key.unlocked = 1;
        bullets.sprite.SetOpacity(0);
        show_key(key.done, 1);
      }
  }

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayMessageFunction(display_message_callback);
