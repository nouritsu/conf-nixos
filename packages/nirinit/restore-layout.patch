+/// Whether this niri session is still to be restored, marking it restored.
+/// A restarted nirinit would otherwise open every window a second time.
+fn first_restore() -> bool {
+   let (Some(runtime_dir), Some(socket)) = (env::var_os("XDG_RUNTIME_DIR"), env::var_os("NIRI_SOCKET"))
+   else {
+      return true;
+   };
+   let Some(socket_name) = Path::new(&socket).file_name() else {
+      return true;
+   };
+
+   let mut marker = OsString::from("nirinit-restored-");
+   marker.push(socket_name);
+   !matches!(
+      fs::File::create_new(Path::new(&runtime_dir).join(marker)),
+      Err(err) if err.kind() == io::ErrorKind::AlreadyExists
+   )
 }
 
